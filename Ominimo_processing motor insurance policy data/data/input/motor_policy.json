{
  "dataflows": [
    {
      "name": "motor-ingestion",
      "sources": [
        {
          "name": "policy_inputs1",
          "path": "data/input/events/motor_policy/batch_1.json",
          "format": "jsonl"
        },
        {
          "name": "policy_inputs2",
          "path": "data/input/events/motor_policy/batch_2.json",
          "format": "jsonl"
        }
      ],
      "transformations": [
        {
          "name": "validation",
          "type": "validate_fields",
          "params": {
            "input": ["policy_inputs1", "policy_inputs2"],
            "validations": [
              { "field": "policy_number", "validations": ["notNull", "notEmpty"] },
              { "field": "plate_number", "validations": ["notNull", "notEmpty"] },
              { "field": "driver_age", "validations": ["notNull", "isInt", "range:18:99"] }
            ]
          }
        },
        {
          "name": "add_ingestion_date",
          "type": "add_fields",
          "params": {
            "input": "validation_ok",
            "addFields": [
              { "name": "ingestion_dt", "function": "current_timestamp" }
            ]
          }
        }
      ],
      "sinks": [
        {
          "input": "add_ingestion_date",
          "name": "raw-ok",
          "paths": ["data/output/events/motor_policy"],
          "format": "json",
          "saveMode": "overwrite"
        },
        {
          "input": "validation_ko",
          "name": "raw-ko",
          "paths": ["data/output/discards/motor_policy"],
          "format": "json",
          "saveMode": "overwrite"
        }
      ]
    }
  ]
}
